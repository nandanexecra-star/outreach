# GROQ_API_KEY: Primary AI Copilot key for Groq LLM endpoints (stored in secrets / .env, never exposed client-side).
GROQ_API_KEY=""

# GEMINI_API_KEY: Optional fallback AI key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MAIL_CREDENTIALS_KEY: 64-character hex string for AES-256-GCM encryption of SMTP/IMAP credentials.
MAIL_CREDENTIALS_KEY=""

# CRON_SECRET: Optional Bearer token for authorizing /api/jobs/* cron triggers.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# DEPLOYMENT: Vercel (frontend) + Render (backend) + Firebase (database)
# ---------------------------------------------------------------------------

# CORS_ORIGIN: Set in Render environment variables — your Vercel frontend URL(s).
# Comma-separate multiple origins: https://app.vercel.app,https://custom.domain.com
CORS_ORIGIN=""

# VITE_API_URL: Set in Vercel environment variables — your Render backend URL.
# Example: https://decile-outreach.onrender.com
# Leave empty in development (calls stay relative to the local Express server).
VITE_API_URL=""

# ---------------------------------------------------------------------------
# FIREBASE ADMIN SDK (server-side Firestore access)
# Get these from Firebase Console → Project Settings → Service Accounts → Generate Key
# ---------------------------------------------------------------------------

# FIREBASE_PROJECT_ID: Your Firebase project ID (already known: ai-studio-applet-webapp-58eee)
FIREBASE_PROJECT_ID="ai-studio-applet-webapp-58eee"

# FIREBASE_CLIENT_EMAIL: service-account client_email from the downloaded JSON key
FIREBASE_CLIENT_EMAIL=""

# FIREBASE_PRIVATE_KEY: service-account private_key (the full -----BEGIN ... -----END string)
# In Render, paste it as-is. The app automatically converts literal \n to newlines.
FIREBASE_PRIVATE_KEY=""

